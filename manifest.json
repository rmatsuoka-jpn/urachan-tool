{
  "manifest_version": 3,
  "name": "うらちゃんツール",
  "short_name": "うらちゃん",
  "version": "0.1.1",
  "description": "閉域環境で使える、定型文コピーと業務支援のサイドパネル。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "うらちゃんツールを開く"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
