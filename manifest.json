{
  "manifest_version": 3,
  "name": "うらちゃんツール",
  "short_name": "うらちゃん",
  "version": "0.2.0",
  "description": "閉域環境で使える、定型文コピーと日付変換などの業務支援サイドパネル。",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "うらちゃんツールを開く"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
